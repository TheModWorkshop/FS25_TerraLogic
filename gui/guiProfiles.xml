<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUIProfiles>
    <!-- Same proven ESC-menu root/layout pattern used by Yield Tracker. -->
    <Profile name="terraLogicAnalysisMainContainer" extends="fs25_menuContainer" with="anchorMiddleLeft">
        <position value="134px -0.03" />
    </Profile>
    <Profile name="terraLogicAnalysisHeaderIcon" extends="baseReference" with="anchorMiddleCenter">
        <size value="50px 50px" />
        <imageSliceId value="noSlice" />
    </Profile>
    <!-- Keep the selected caption tied to the game's configurable accent
         preset instead of the Vanilla tab profile's fixed dark caption. -->
    <Profile name="terraLogicAnalysisSubCategoryTab" extends="fs25_subCategorySelectorTabbedTab">
        <textSelectedColor value="$preset_fs25_colorMainHighlight" />
    </Profile>
    <Profile name="terraLogicAnalysisCard" extends="emptyPanel" with="anchorTopLeft pivotTopLeft" />
    <Profile name="terraLogicAnalysisPlannerContent" extends="emptyPanel" with="anchorTopLeft pivotTopLeft" />
    <Profile name="terraLogicAnalysisPlannerRow" extends="emptyPanel" with="anchorTopLeft pivotTopLeft" />
    <Profile name="terraLogicAnalysisPage" extends="baseReference" with="anchorBottomLeft">
        <position value="0 0" />
        <size value="1550px 0.70" />
    </Profile>
    <Profile name="terraLogicAnalysisCardSeparator" extends="fs25_lineSeparatorBottom" with="anchorTopLeft pivotTopLeft" />
    <Profile name="terraLogicAnalysisHelpButton" extends="baseReference" with="anchorTopLeft pivotTopLeft">
        <size value="30px 30px" />
        <textSize value="18px" />
        <textBold value="true" />
        <textAlignment value="center" />
        <textVerticalAlignment value="middle" />
        <textColor value="$preset_fs25_colorMainHighlight" />
        <textHighlightedColor value="$preset_colorWhite" />
        <textFocusedColor value="$preset_colorWhite" />
        <textSelectedColor value="$preset_colorWhite" />
        <imageColor value="0 0 0 0" />
        <handleFocus value="true" />
    </Profile>
    <Profile name="terraLogicAnalysisMapButton" extends="terraLogicAnalysisHelpButton">
        <size value="210px 48px" />
        <textSize value="16px" />
    </Profile>
    <Profile name="terraLogicAnalysisCardHeader" extends="fs25_textDefault" with="anchorTopLeft pivotTopLeft">
        <textSize value="21px" />
        <textBold value="true" />
        <textUpperCase value="true" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textAlignment value="left" />
        <textVerticalAlignment value="middle" />
    </Profile>
    <Profile name="terraLogicAnalysisLabel" extends="fs25_textDefault" with="anchorTopLeft pivotTopLeft">
        <textSize value="17px" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textAlignment value="left" />
        <textVerticalAlignment value="middle" />
    </Profile>
    <Profile name="terraLogicAnalysisValue" extends="fs25_textDefault" with="anchorTopLeft pivotTopLeft">
        <textSize value="17px" />
        <textBold value="true" />
        <textColor value="$preset_colorWhite" />
        <textAlignment value="right" />
        <textVerticalAlignment value="middle" />
    </Profile>
    <Profile name="terraLogicAnalysisBody" extends="fs25_textDefault" with="anchorTopLeft pivotTopLeft">
        <textSize value="16px" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textAlignment value="left" />
        <textVerticalAlignment value="top" />
        <textMaxNumLines value="10" />
        <textLayoutMode value="overflow" />
    </Profile>
    <Profile name="terraLogicAnalysisListBody" extends="terraLogicAnalysisBody">
        <textSize value="15px" />
        <textMaxNumLines value="30" />
    </Profile>
    <Profile name="terraLogicAnalysisNote" extends="terraLogicAnalysisBody">
        <textSize value="14px" />
        <textColor value="$preset_colorWhite_50" />
    </Profile>
    <Profile name="terraLogicAnalysisFieldScope" extends="terraLogicAnalysisNote">
        <textMaxNumLines value="1" />
        <textLayoutMode value="truncate" />
    </Profile>
    <Profile name="terraLogicAnalysisFieldSelection" extends="terraLogicAnalysisFieldScope">
        <textAlignment value="center" />
        <textVerticalAlignment value="middle" />
        <textHighlightedColor value="$preset_fs25_colorMainHighlight" />
        <textFocusedColor value="$preset_fs25_colorMainHighlight" />
        <imageColor value="0 0 0 0" />
        <handleFocus value="true" />
    </Profile>
    <Profile name="terraLogicAnalysisSelectionNote" extends="terraLogicAnalysisFieldScope">
        <textVerticalAlignment value="middle" />
    </Profile>
    <Profile name="terraLogicAnalysisFieldListRow" extends="baseReference" with="anchorTopStretchingX alternating">
        <height value="38px" />
        <imageColor value="$preset_fs25_colorGrey" />
        <imageSelectedColor value="$preset_fs25_colorMainHighlight" />
        <alternateBackgroundColor value="$preset_fs25_colorGreyDark_50" />
    </Profile>
    <Profile name="terraLogicAnalysisFieldListText" extends="baseReference" with="anchorTopLeft pivotTopLeft">
        <textSize value="16px" />
        <textColor value="$preset_fs25_colorMainLight" />
        <textSelectedColor value="$preset_fs25_colorMainDark" />
        <textVerticalAlignment value="middle" />
        <textMaxNumLines value="1" />
        <textLayoutMode value="truncate" />
    </Profile>
    <Profile name="terraLogicAnalysisHero" extends="fs25_textDefault" with="anchorTopLeft pivotTopLeft">
        <textSize value="34px" />
        <textBold value="true" />
        <textColor value="$preset_colorWhite" />
        <textAlignment value="right" />
        <textVerticalAlignment value="middle" />
    </Profile>
    <Profile name="terraLogicAnalysisCropValue" extends="terraLogicAnalysisValue">
        <textSize value="16px" />
        <textVerticalAlignment value="top" />
        <textMaxNumLines value="2" />
        <textLayoutMode value="overflow" />
    </Profile>
    <Profile name="terraLogicAnalysisCoverage" extends="terraLogicAnalysisNote">
        <textSize value="13px" />
        <textColor value="0.65 0.65 0.65 1" />
        <textMaxNumLines value="2" />
    </Profile>
</GUIProfiles>
